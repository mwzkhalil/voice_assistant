# ============================================================
# Voice Assistant Environment Configuration
# Copy to .env and fill in production values.
# ============================================================

# --- Transport Mode ---
# WS = WebSocket (public realtime, default)
# ARI = Asterisk ARI (telephony)
TRANSPORT_MODE=WS

# --- Authentication (public mode) ---
AUTH_ENABLED=true
AUTH_API_KEYS=your-secret-key-1,your-secret-key-2
AUTH_RATE_LIMIT_PER_MINUTE=60
AUTH_MAX_SESSIONS_PER_IP=5
AUTH_MAX_AUDIO_DURATION_SECONDS=600
AUTH_MAX_CHUNK_SIZE_BYTES=32768
AUTH_IDLE_SESSION_TIMEOUT=300

# --- Asterisk ARI (only used when TRANSPORT_MODE=ARI) ---
ARI_HOST=localhost
ARI_PORT=8088
ARI_WS_PORT=8088
ARI_USERNAME=asterisk
ARI_PASSWORD=asterisk
ARI_APP_NAME=voice-assistant

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_MAX_SIZE=20

# --- Ollama LLM ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL_NAME=mahwiz/zoma
OLLAMA_MAX_TOKENS=512
OLLAMA_REQUEST_TIMEOUT=30

# --- ASR ---
ASR_MODEL_NAME=sajadkawa/ns_finetune_urdu_asr_org
ASR_DEVICE=auto

# --- TTS ---
TTS_MODEL_NAME=suhaibrashid17/MMS_TTS_Urdu_3
TTS_DEVICE=auto
TTS_OUTPUT_SAMPLE_RATE=16000

# --- VAD ---
VAD_AGGRESSIVENESS=2
VAD_SILENCE_THRESHOLD_MS=800

# --- RTP (only used when TRANSPORT_MODE=ARI) ---
RTP_LISTEN_HOST=0.0.0.0
RTP_PORT_RANGE_START=10000
RTP_PORT_RANGE_END=20000
RTP_CODEC=ulaw

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_WORKERS=1
SERVER_LOG_LEVEL=INFO
SERVER_DEBUG=false
SERVER_MAX_CONCURRENT_CALLS=200
